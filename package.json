{
  "name": "acetrack",
  "version": "1.0.0",
  "description": "AceTrack Attendance Management System - Monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --stream dev",
    "dev:api": "pnpm --filter acetrack-api dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --recursive build",
    "build:api": "pnpm --filter acetrack-api build",
    "build:frontend": "pnpm --filter frontend build",
    "start": "pnpm --parallel --stream start",
    "start:api": "pnpm --filter acetrack-api start",
    "start:frontend": "pnpm --filter frontend start",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "format": "pnpm --recursive format",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --filter acetrack-api test",
    "test:watch": "pnpm --filter acetrack-api test:watch",
    "clean": "pnpm --recursive exec rm -rf node_modules dist .next",
    "clean:install": "pnpm clean && pnpm install"
  },
  "keywords": [
    "acetrack",
    "attendance",
    "management",
    "monorepo"
  ],
  "author": "ACES-DOrSU",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}

